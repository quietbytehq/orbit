{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit for rclone",
  "version": "1.0.0",
  "identifier": "com.orbit.rclone",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "Orbit",
        "url": "splash",
        "width": 360,
        "height": 360,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "skipTaskbar": true,
        "focus": false
      },
      {
        "label": "main",
        "title": "Orbit for rclone",
        "url": "/",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 540,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/rclone"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
